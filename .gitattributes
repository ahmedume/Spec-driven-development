* text=auto eol=lf

# Text files
*.md         text eol=lf
*.txt        text eol=lf
*.py         text eol=lf
*.js         text eol=lf
*.sh         text eol=lf
*.csv        text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.xml        text eol=lf
*.LICENSE    text eol=lf
*.svg        text eol=lf

# Binary assets — never touch
*.ttf        binary
*.otf        binary
*.gz         binary
*.png        binary
*.jpg        binary
*.ico        binary
*.pdf        binary
*.zip        binary
*.tar.gz     binary

# Keep consistent line endings even on Windows clones
*.docx       binary
*.xlsx       binary
*.pptx       binary
